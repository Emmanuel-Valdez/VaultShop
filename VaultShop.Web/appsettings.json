{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SiteUrl": "https://vaultshop.evaldez.ar",
  "Branding": {
    "PublicName": "VaultShop",
    "LogoPath": "/images/brand/vaultshop-logo.svg",
    "LogoDarkPath": "/images/brand/vaultshop-logo-dark.svg",
    "MarkPath": "/images/brand/vaultshop-mark.svg",
    "AppleTouchIconPath": "/images/brand/vaultshop-mark.svg",
    "SocialPreviewImagePath": "/images/brand/vaultshop-og.svg",
    "TwitterSite": "@VaultShop"
  },
  "Theme": {
    "Primary": "#1a2a4a",
    "PrimaryDark": "#0d1625",
    "Accent": "#d4a017",
    "Surface": "#f7f8fa",
    "SurfaceDark": "#1e2030"
  },
  "Storefront": {
    "ShowDemoNotice": true
  },
  "Pagination": {
    "PageSize": 12
  },
  // Admin/Employee requests intentionally use the global limit; they are not exempt.
  // Missing static assets, source maps, and well-known probes match no endpoint and do not consume budget.
  // Production serves bundled/minified assets without source maps, so map requests do not occur there.
  // Every value below can be overridden per environment (local, testing, production) without code changes.
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 0,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "LoginQueueLimit": 0,
    "CheckoutPermitLimit": 10,
    "CheckoutWindowSeconds": 60,
    "CheckoutQueueLimit": 0,
    "RecoveryPermitLimit": 5,
    "RecoveryWindowSeconds": 60,
    "RecoveryQueueLimit": 0,
    "CartPermitLimit": 60,
    "CartWindowSeconds": 60,
    "CartQueueLimit": 0,
    "SearchPermitLimit": 60,
    "SearchWindowSeconds": 60,
    "SearchQueueLimit": 0
  },
  "Identity": {
    "Lockout": {
      "AllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpanMinutes": 5
    }
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "ImageStorage": {
    "Provider": "Local",
    "Minio": {
      "Endpoint": "localhost:9000",
      "UseSsl": false,
      "BucketName": "product-images",
      "AccessKey": "",
      "SecretKey": "",
      "PublicBaseUrl": "http://localhost:9000/product-images"
    }
  },
  "Payments": {
    "Reconciliation": {
      "Enabled": false,
      "Interval": "00:10:00",
      "StaleAfter": "00:05:00",
      "MaxAge": "48:00:00",
      "BatchSize": 20
    }
  }
}
