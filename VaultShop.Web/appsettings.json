{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SiteUrl": "https://vaultshop.evaldez.ar",
  "Branding": {
    "PublicName": "VaultShop",
    "LogoPath": "/images/brand/vaultshop-logo.svg",
    "LogoDarkPath": "/images/brand/vaultshop-logo-dark.svg",
    "MarkPath": "/images/brand/vaultshop-mark.svg",
    "AppleTouchIconPath": "/images/brand/vaultshop-mark.svg",
    "SocialPreviewImagePath": "/images/brand/vaultshop-og.svg",
    "TwitterSite": "@VaultShop"
  },
  "Theme": {
    "Primary": "#1a2a4a",
    "PrimaryDark": "#0d1625",
    "Accent": "#d4a017",
    "Surface": "#f7f8fa",
    "SurfaceDark": "#1e2030"
  },
  "Storefront": {
    "ShowDemoNotice": true
  },
  "Pagination": {
    "PageSize": 12
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 0,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "LoginQueueLimit": 0
  },
  "Identity": {
    "Lockout": {
      "AllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpanMinutes": 5
    }
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "ImageStorage": {
    "Provider": "Local",
    "Minio": {
      "Endpoint": "localhost:9000",
      "UseSsl": false,
      "BucketName": "product-images",
      "AccessKey": "",
      "SecretKey": "",
      "PublicBaseUrl": "http://localhost:9000/product-images"
    }
  },
  "Payments": {
    "Reconciliation": {
      "Enabled": false,
      "Interval": "00:10:00",
      "StaleAfter": "00:05:00",
      "MaxAge": "48:00:00",
      "BatchSize": 20
    }
  }
}
