@model Coupon

<div class="card shadow border-0 my-4">
	<div class="card-header bg-primary bg-gradient ml-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h2 class="text-secondary"> @(Model.Id != 0 ? Localizer["Update"] : Localizer["Create"]) @Localizer["Coupon"]</h2>
			</div>
		</div>
	</div>
	<div class="card-body p-4">

		<form method="post">
			@Html.AntiForgeryToken()
			<input asp-for="Id" hidden />
			<div class="border p-3 ">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<div class="mb-3">
					<div class="form-floating mb-3 col-md-12 shadow">
						<input asp-for="Code" class="form-control text-uppercase" placeholder="Code" />
						<label asp-for="Code" class="ms-2 text-muted">@Localizer["Code"]</label>
					</div>
					<span asp-validation-for="Code" class="text-danger"></span>
				</div>
				<div class="row g-3">
					<div class="col-md-6">
						<div class="form-floating shadow">
							<select asp-for="DiscountType" asp-items="Html.GetEnumSelectList<CouponDiscountType>()" class="form-select"></select>
							<label asp-for="DiscountType" class="ms-2 text-muted">@Localizer["Type"]</label>
						</div>
						<span asp-validation-for="DiscountType" class="text-danger"></span>
					</div>
					<div class="col-md-6">
						<div class="input-group shadow">
							<span class="input-group-text text-dark">$ / %</span>
							<div class="form-floating">
								<input asp-for="Value" class="form-control" type="number" min="0" step="0.01" placeholder="Value" />
								<label asp-for="Value" class="ms-2 text-muted">@Localizer["Value"]</label>
							</div>
						</div>
						<span asp-validation-for="Value" class="text-danger"></span>
					</div>
					<div class="col-md-6">
						<div class="input-group shadow">
							<span class="input-group-text text-dark">$</span>
							<div class="form-floating">
								<input asp-for="MinSubtotal" class="form-control" type="number" min="0" step="0.01" placeholder="MinSubtotal" />
								<label asp-for="MinSubtotal" class="ms-2 text-muted">@Localizer["MinSubtotal"]</label>
							</div>
						</div>
						<span asp-validation-for="MinSubtotal" class="text-danger"></span>
					</div>
					<div class="col-md-6">
						<div class="form-floating shadow">
							<input asp-for="MaxUses" class="form-control" type="number" min="1" step="1" placeholder="MaxUses" />
							<label asp-for="MaxUses" class="ms-2 text-muted">@Localizer["MaxUses"]</label>
						</div>
						<span asp-validation-for="MaxUses" class="text-danger"></span>
					</div>
					<div class="col-md-6">
						<div class="form-floating shadow">
							<input asp-for="ValidFromUtc" class="form-control" type="datetime-local" placeholder="ValidFrom" />
							<label asp-for="ValidFromUtc" class="ms-2 text-muted">@Localizer["ValidFrom"]</label>
						</div>
						<span asp-validation-for="ValidFromUtc" class="text-danger"></span>
					</div>
					<div class="col-md-6">
						<div class="form-floating shadow">
							<input asp-for="ValidToUtc" class="form-control" type="datetime-local" placeholder="ValidTo" />
							<label asp-for="ValidToUtc" class="ms-2 text-muted">@Localizer["ValidTo"]</label>
						</div>
						<span asp-validation-for="ValidToUtc" class="text-danger"></span>
					</div>
				</div>
				@if (Model.Id != 0)
				{
					<div class="form-text mt-3">@Localizer["UsesSoFar", Model.UsesCount]</div>
				}
				<div class="form-check form-switch py-2 col-12">
					<input asp-for="IsActive" class="form-check-input" role="switch" />
					<label asp-for="IsActive" class="form-check-label ms-2">@Localizer["Active"]</label>
				</div>
				<div class="row mt-3">
					<div class="col-6 col-md-3">
						@if (Model.Id != 0)
						{
							<button type="submit" class="btn btn-primary form-control">@Localizer["Update"]</button>
						}
						else
						{
							<button type="submit" class="btn btn-primary form-control">@Localizer["Create"]</button>
						}
					</div>
					<div class="col-6 col-md-3">
						<a asp-controller="Coupon" asp-action="Index" class="btn btn-outline-primary border form-control">
							@Localizer["BackToList"]
						</a>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>


@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
}
