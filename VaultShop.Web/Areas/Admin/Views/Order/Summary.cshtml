@model OrderSummaryViewModel
@{
	ViewData["Title"] = Localizer["OrderSummaryTitle"];
}

<div class="container py-4">
	<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
		<h2 class="mb-0">@Localizer["OrderSummaryTitle"] #@Model.OrderId</h2>
		<div class="d-flex gap-2">
			<a asp-action="DownloadSummary" asp-route-orderId="@Model.OrderId" class="btn btn-outline-primary">
				<i class="bi bi-file-earmark-pdf"></i> @Localizer["DownloadPdfButton"]
			</a>
			<a asp-action="Details" asp-route-orderId="@Model.OrderId" class="btn btn-light text-dark border">
				@Localizer["BackToOrderDetails"]
			</a>
		</div>
	</div>

	<div class="alert alert-warning" role="alert">
		<strong>@Localizer["NonFiscalLegend"]</strong>
	</div>

	<div class="row g-4">
		<div class="col-12 col-lg-6">
			<div class="card h-100">
				<div class="card-header bg-body-tertiary">
					<h5 class="mb-0">@Localizer["OrderInfoTitle"]</h5>
				</div>
				<div class="card-body">
					<dl class="row mb-0">
						<dt class="col-sm-5">@Localizer["OrderDateLabel"]</dt>
						<dd class="col-sm-7">@Model.OrderDate.ToString("d")</dd>

						<dt class="col-sm-5">@Localizer["OrderStatusLabel"]</dt>
						<dd class="col-sm-7"><span class="badge bg-primary">@Localizer[Model.OrderStatus ?? string.Empty]</span></dd>

						<dt class="col-sm-5">@Localizer["PaymentStatusLabel"]</dt>
						<dd class="col-sm-7"><span class="badge bg-info text-dark">@Localizer[Model.PaymentStatus ?? string.Empty]</span></dd>

						<dt class="col-sm-5">@Localizer["PaymentMethodLabel"]</dt>
						<dd class="col-sm-7">@Localizer[Model.PaymentMethod ?? "Unspecified"]</dd>

						@if (Model.PaymentDueDate != default)
						{
							<dt class="col-sm-5">@Localizer["PaymentDueDateLabel"]</dt>
							<dd class="col-sm-7">@Model.PaymentDueDate.ToString("d")</dd>
						}
					</dl>
				</div>
			</div>
		</div>

		<div class="col-12 col-lg-6">
			<div class="card h-100">
				<div class="card-header bg-body-tertiary">
					<h5 class="mb-0">@Localizer["CustomerInfoTitle"]</h5>
				</div>
				<div class="card-body">
					<p class="mb-1 fw-semibold">@Model.CustomerName</p>
					@if (!string.IsNullOrWhiteSpace(Model.CompanyName))
					{
						<p class="mb-1">@Model.CompanyName</p>
						@if (!string.IsNullOrWhiteSpace(Model.RazonSocial))
						{
							<p class="mb-1 text-muted">@Localizer["RazonSocialLabel"]: @Model.RazonSocial</p>
						}
						@if (!string.IsNullOrWhiteSpace(Model.DomicilioFiscal))
						{
							<p class="mb-1 text-muted">@Localizer["DomicilioFiscalLabel"]: @Model.DomicilioFiscal</p>
						}
						@if (!string.IsNullOrWhiteSpace(Model.Cuit))
						{
							<p class="mb-1 text-muted">@Localizer["CuitLabel"]: @Model.Cuit</p>
						}
					}
				</div>
			</div>
		</div>

		<div class="col-12">
			<div class="card">
				<div class="card-header bg-body-tertiary">
					<h5 class="mb-0">@Localizer["ShippingInfoTitle"]</h5>
				</div>
				<div class="card-body">
					<p class="mb-1">@Model.ShippingName</p>
					<p class="mb-1">@Model.ShippingStreetAddress</p>
					<p class="mb-1">@Model.ShippingCity, @Model.ShippingState @Model.ShippingPostalCode</p>
					<p class="mb-0">@Model.ShippingPhoneNumber</p>
				</div>
			</div>
		</div>

		@if (!string.IsNullOrWhiteSpace(Model.PickupAgencyCode))
		{
			<div class="col-12">
				<div class="card">
					<div class="card-header bg-body-tertiary">
						<h5 class="mb-0">@Localizer["PickupAgencyTitle"]</h5>
					</div>
					<div class="card-body">
						<p class="mb-1 fw-semibold">@Model.PickupAgencyName</p>
						<p class="mb-1">@Model.PickupAgencyCode</p>
						<p class="mb-0">@Model.PickupAgencyAddress</p>
					</div>
				</div>
			</div>
		}

		<div class="col-12">
			<div class="card">
				<div class="card-header bg-body-tertiary">
					<h5 class="mb-0">@Localizer["ItemsTitle"]</h5>
				</div>
				<div class="card-body p-0">
					<table class="table table-striped mb-0">
						<thead>
							<tr>
								<th>@Localizer["ProductHeader"]</th>
								<th class="text-end">@Localizer["UnitPriceHeader"]</th>
								<th class="text-center">@Localizer["QuantityHeader"]</th>
								<th class="text-end">@Localizer["LineTotalHeader"]</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.Items)
							{
								<tr>
									<td>@item.ProductName</td>
									<td class="text-end">@item.UnitPrice.ToString("c")</td>
									<td class="text-center">@item.Quantity</td>
									<td class="text-end">@item.LineTotal.ToString("c")</td>
								</tr>
							}
						</tbody>
						<tfoot>
							<tr>
								<th colspan="3" class="text-end">@Localizer["TotalLabel"]</th>
								<th class="text-end">@Model.OrderTotal.ToString("c")</th>
							</tr>
						</tfoot>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
