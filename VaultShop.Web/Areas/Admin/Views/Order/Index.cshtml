@{
	var status = Context.Request.Query["Status"];
	var pending = "btn btn-sm rounded-pill btn-outline-warning";
	var inprocess = "btn btn-sm rounded-pill btn-outline-info";
	var completed = "btn btn-sm rounded-pill btn-outline-success";
	var approved = "btn btn-sm rounded-pill btn-outline-success";
	var all = "btn btn-sm rounded-pill btn-outline-primary";

	switch (status)
	{
		case "pending":
			pending = "btn btn-sm rounded-pill btn-warning text-dark";
			break;
		case "inprocess":
			inprocess = "btn btn-sm rounded-pill btn-info text-dark";
			break;
		case "completed":
			completed = "btn btn-sm rounded-pill btn-success";
			break;
		case "approved":
			approved = "btn btn-sm rounded-pill btn-success";
			break;
		default:
			all = "btn btn-sm rounded-pill btn-primary";
			break;
	}
}
<div class="card shadow border-0 my-4">
	<div class="card-header bg-primary bg-gradient ml-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h2 class="text-white text-center">@Localizer["OrderList"]</h2>
			</div>
		</div>
	</div>
	<div class="card-body p-4">
		<div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
			<a class="@inprocess" asp-controller="Order" asp-action="Index" asp-route-status="inprocess">@Localizer["InProcess"]</a>
			<a class="@pending" asp-controller="Order" asp-action="Index" asp-route-status="pending">@Localizer["PaymentPending"]</a>
			<a class="@completed" asp-controller="Order" asp-action="Index" asp-route-status="completed">@Localizer["Completed"]</a>
			<a class="@approved" asp-controller="Order" asp-action="Index" asp-route-status="approved">@Localizer["Approved"]</a>
			<a class="@all" asp-controller="Order" asp-action="Index" asp-route-status="all">@Localizer["All"]</a>
		</div>

		<table id="tblData" class="table table-bordered table-striped table-hover" style="width:100%">
			<thead>
				<tr>
					<th>@Localizer["Id"]</th>
					<th>@Localizer["Name"]</th>
					<th>@Localizer["PhoneNumber"]</th>
					<th>@Localizer["Email"]</th>
					@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
					{
						<th>@Localizer["Company"]</th>
					}
					<th>@Localizer["OrderStatus"]</th>
					<th>@Localizer["PaymentStatus"]</th>
					<th>@Localizer["PaymentMethod"]</th>
					<th>@Localizer["Total"]</th>
					<th></th>
				</tr>
			</thead>
		</table>
	</div>
</div>


@section Scripts {
	<script>
		window.orderStatusTranslations = {
			Pending: @Json.Serialize(Localizer["Pending"].Value),
			Approved: @Json.Serialize(Localizer["Approved"].Value),
			Processing: @Json.Serialize(Localizer["Processing"].Value),
			Shipped: @Json.Serialize(Localizer["Shipped"].Value),
			Cancelled: @Json.Serialize(Localizer["Cancelled"].Value),
			Refunded: @Json.Serialize(Localizer["Refunded"].Value)
		};
		window.paymentStatusTranslations = {
			Pending: @Json.Serialize(Localizer["Pending"].Value),
			Approved: @Json.Serialize(Localizer["Approved"].Value),
			ApprovedForDelayedPayment: @Json.Serialize(Localizer["ApprovedForDelayedPayment"].Value),
			Rejected: @Json.Serialize(Localizer["Rejected"].Value),
			Refunded: @Json.Serialize(Localizer["Refunded"].Value),
			Cancelled: @Json.Serialize(Localizer["Cancelled"].Value)
		};
		window.paymentMethodTranslations = {
			Unspecified: @Json.Serialize(Localizer["Unspecified"].Value),
			Stripe: @Json.Serialize(Localizer["Stripe"].Value),
			BankTransfer: @Json.Serialize(Localizer["BankTransfer"].Value),
			MercadoPago: @Json.Serialize(Localizer["MercadoPago"].Value)
		};
		window.orderTableTranslations = {
			exportToPDF: @Json.Serialize(Localizer["ExportToPDF"].Value),
			columnsVisibility: @Json.Serialize(Localizer["ColumnsVisibility"].Value)
		};
	</script>

	@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
	{
		<script src="~/js/orderAdmin.js"></script>
	}
	else
	{
		<script src="~/js/order.js"></script>
	}
}
