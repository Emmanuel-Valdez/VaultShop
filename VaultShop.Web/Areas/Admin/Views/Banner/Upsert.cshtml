@model BannerVM
@using VaultShop.Models
@{
	var previewCover = Model.Banner.Images.FirstOrDefault(i => i.Kind == BannerImageKind.Master)
		?? Model.Banner.Images.FirstOrDefault(i => i.Kind == BannerImageKind.Medium)
		?? Model.Banner.Images.FirstOrDefault(i => i.Kind == BannerImageKind.Small);
	var previewMobile = Model.Banner.Images.FirstOrDefault(i => i.Kind == BannerImageKind.Mobile);
	string? previewCoverUrl = previewCover?.ImageUrl;
	string? previewMobileUrl = previewMobile?.ImageUrl;
	// banner-preview-safe-zone 5.2: art-direction parity with the storefront (mobile asset is ImageLed-only).
	var previewMobileFrameUrl = Model.Banner.Layout == BannerLayout.ImageLed ? (previewMobileUrl ?? previewCoverUrl) : previewCoverUrl;
	var previewLayoutClass = Model.Banner.Layout == BannerLayout.ImageLed ? "banner--layout-imageled" : "banner--layout-crossed";
	var previewColorClass = "banner--color-" + Model.Banner.TextColor.ToString().ToLowerInvariant();
	var previewMobileAspect = Model.Banner.Layout == BannerLayout.ImageLed ? "banner-preview__mobile--imageled" : "banner-preview__mobile--crossed";
	var previewAlt = !string.IsNullOrWhiteSpace(Model.Banner.AltText) ? Model.Banner.AltText : Model.Banner.Title ?? string.Empty;
	var previewHasRect = Model.Banner.SafeZoneLeft.HasValue && Model.Banner.SafeZoneTop.HasValue && Model.Banner.SafeZoneWidth.HasValue && Model.Banner.SafeZoneHeight.HasValue;
	string? previewRectStyle = null;
	string? previewFrameVars = null;
	if (previewHasRect)
	{
		var invariant = System.Globalization.CultureInfo.InvariantCulture;
		string Pct(decimal v) => v.ToString("0.###", invariant) + "%";
		var l = Model.Banner.SafeZoneLeft!.Value; var t = Model.Banner.SafeZoneTop!.Value;
		var w = Model.Banner.SafeZoneWidth!.Value; var h = Model.Banner.SafeZoneHeight!.Value;
		previewRectStyle = $"left:{Pct(l * 100)};top:{Pct(t * 100)};width:{Pct(w * 100)};height:{Pct(h * 100)}";
		previewFrameVars = $"--banner-safe-top:{Pct(t * 100)}; --banner-safe-right:{Pct((1 - (l + w)) * 100)}; --banner-safe-bottom:{Pct((1 - (t + h)) * 100)}; --banner-safe-left:{Pct(l * 100)}";
	}
}

<div data-banner-preview data-cover-url="@previewCoverUrl" data-mobile-url="@previewMobileUrl">
	@* banner-preview-safe-zone 5.3: desktop preview at live size (100vw) so vw-based clamp() type matches the home banner. *@
	<section class="mt-4">
		<h3 class="h5 mb-3 text-primary">@Localizer["PreviewDesktop"]</h3>
		<div class="banner-preview__frame banner-preview__desktop u-breakout @previewLayoutClass @previewColorClass" data-preview-frame="desktop" style="@previewFrameVars">
			<img class="banner__image" data-preview-img src="@previewCoverUrl" alt="@previewAlt" @(previewCoverUrl == null ? "hidden" : null) />
			<div class="banner__scrim" aria-hidden="true"></div>
			<div class="banner__content">
				<span class="banner__title" data-preview-title @(string.IsNullOrWhiteSpace(Model.Banner.Title) ? "hidden" : null)>@Model.Banner.Title</span>
				<span class="banner__hook" data-preview-hook @(string.IsNullOrWhiteSpace(Model.Banner.Hook) ? "hidden" : null)>@Model.Banner.Hook</span>
				<span class="banner__body" data-preview-body @(string.IsNullOrWhiteSpace(Model.Banner.Body) ? "hidden" : null)>@Model.Banner.Body</span>
				<span class="banner__cta" data-preview-cta @(string.IsNullOrWhiteSpace(Model.Banner.CallToAction) ? "hidden" : null)>@Model.Banner.CallToAction</span>
			</div>
			<div class="banner-preview__editor" data-safezone-editor>
				<div class="banner-preview__safezone" data-safezone-rect tabindex="0" aria-label="@Localizer["SafeZoneEditor"]" style="@previewRectStyle" @(previewHasRect ? null : "hidden")><span class="banner-preview__safezone-handle" data-safezone-handle></span></div>
			</div>
			<div class="empty-state rounded-3 p-4 text-center text-muted" data-preview-empty @(previewCoverUrl == null ? null : "hidden")>
				<i class="bi bi-image fs-2 d-block mb-2" aria-hidden="true"></i>
				@Localizer["NoPreviewImage"]
			</div>
		</div>
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 mb-3">
			<p class="form-text m-0">@Localizer["SafeZoneHint"]</p>
			<button type="button" class="btn btn-outline-secondary btn-sm" data-safezone-reset>@Localizer["SafeZoneReset"]</button>
		</div>
	</section>
	<div class="card shadow border-0 my-4">
		<div class="card-header bg-primary bg-gradient ml-0 py-3">
			<div class="row">
				<div class="col-12 text-center">
					<h2 class="text-secondary"> @(Model.Banner.Id != 0 ? Localizer["Update"] : Localizer["Create"]) @Localizer["Banner"] </h2>
				</div>
			</div>
		</div>
		<div class="card-body p-4">
			<div class="row g-4">
				<div class="col-12 col-lg-8">
					<form method="post" enctype="multipart/form-data">
						@Html.AntiForgeryToken()
						<input asp-for="Banner.Id" hidden />
						<input asp-for="Banner.SafeZoneLeft" type="hidden" />
						<input asp-for="Banner.SafeZoneTop" type="hidden" />
						<input asp-for="Banner.SafeZoneWidth" type="hidden" />
						<input asp-for="Banner.SafeZoneHeight" type="hidden" />
						<div class="border rounded-3 p-3 bg-body-tertiary">
							<div asp-validation-summary="ModelOnly" class="text-danger"></div>
							<div class="row">
								<div class="mb-3 col-md-6">
									<label asp-for="Banner.Layout" class="form-label fw-semibold">@Localizer["Layout"]</label>
									<select asp-for="Banner.Layout" asp-items="Model.LayoutList" class="form-select shadow"></select>
									<span asp-validation-for="Banner.Layout" class="text-danger"></span>
								</div>
								<div class="mb-3 col-md-6">
									<label asp-for="Banner.TextColor" class="form-label fw-semibold">@Localizer["TextColor"]</label>
									<select asp-for="Banner.TextColor" asp-items="Model.TextColorList" class="form-select shadow"></select>
									<span asp-validation-for="Banner.TextColor" class="text-danger"></span>
								</div>
							</div>
							<div class="row">
								<div class="mb-3 col-md-6">
									<label asp-for="Banner.TargetKind" class="form-label fw-semibold">@Localizer["LinkTarget"]</label>
									<select asp-for="Banner.TargetKind" asp-items="Model.TargetKindList" class="form-select shadow"></select>
									<span asp-validation-for="Banner.TargetKind" class="text-danger"></span>
								</div>
								<div class="mb-3 col-md-6">
									<label asp-for="Banner.TargetId" class="form-label fw-semibold">@Localizer["LinkTargetEntity"]</label>
									<select asp-for="Banner.TargetId" asp-items="Model.TargetOptions" class="form-select shadow">
										<option value="">-- @Localizer["NoLinkTarget"] --</option>
									</select>
									<span asp-validation-for="Banner.TargetId" class="text-danger"></span>
								</div>
							</div>
							<div class="mb-3">
								<div class="form-floating mb-3 col-md-12 shadow">
									<input asp-for="Banner.Title" class="form-control" placeholder="Title" />
									<label asp-for="Banner.Title" class="ms-2 text-muted">@Localizer["Title"]</label>
								</div>
								<span asp-validation-for="Banner.Title" class="text-danger"></span>
							</div>
							<div class="mb-3">
								<div class="form-floating mb-3 col-md-12 shadow">
									<input asp-for="Banner.Hook" class="form-control" placeholder="Hook" />
									<label asp-for="Banner.Hook" class="ms-2 text-muted">@Localizer["Hook"]</label>
								</div>
								<span asp-validation-for="Banner.Hook" class="text-danger"></span>
							</div>
							<div class="mb-3">
								<div class="form-floating mb-3 col-md-12 shadow">
									<textarea asp-for="Banner.Body" class="form-control" placeholder="Body" style="height:100px"></textarea>
									<label asp-for="Banner.Body" class="ms-2 text-muted">@Localizer["Body"]</label>
								</div>
								<span asp-validation-for="Banner.Body" class="text-danger"></span>
							</div>
							<div class="mb-3">
								<div class="form-floating mb-3 col-md-12 shadow">
									<input asp-for="Banner.CallToAction" class="form-control" placeholder="CallToAction" />
									<label asp-for="Banner.CallToAction" class="ms-2 text-muted">@Localizer["CallToAction"]</label>
								</div>
								<span asp-validation-for="Banner.CallToAction" class="text-danger"></span>
							</div>
							<div class="mb-3">
								<div class="form-floating mb-3 col-md-12 shadow">
									<input asp-for="Banner.AltText" class="form-control" placeholder="AltText" />
									<label asp-for="Banner.AltText" class="ms-2 text-muted">@Localizer["AltText"]</label>
								</div>
								<span asp-validation-for="Banner.AltText" class="text-danger"></span>
							</div>
							<div class="row">
								<div class="mb-3 col-md-6">
									<div class="form-floating mb-3 shadow">
										<input asp-for="Banner.SortOrder" type="number" class="form-control" placeholder="SortOrder" />
										<label asp-for="Banner.SortOrder" class="ms-2 text-muted">@Localizer["SortOrder"]</label>
									</div>
									<span asp-validation-for="Banner.SortOrder" class="text-danger"></span>
								</div>
								<div class="mb-3 col-md-6">
									<div class="form-check form-switch py-2">
										<input asp-for="Banner.IsActive" class="form-check-input" role="switch" />
										<label asp-for="Banner.IsActive" class="form-check-label ms-2">@Localizer["IsActive"]</label>
									</div>
								</div>
							</div>
							<div class="mb-3">
								<label class="form-label fw-semibold">@Localizer["CoverImage"]</label>
								<input type="file" name="coverFile" class="form-control shadow-sm" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
								<div class="form-text">@Localizer["CoverImageHelp"]</div>
							</div>
							<div class="mb-3">
								<label class="form-label fw-semibold">@Localizer["MobileImage"]</label>
								<input type="file" name="mobileFile" class="form-control shadow-sm" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
								<div class="form-text">@Localizer["MobileImageHelp"]</div>
								<div class="form-text">@Localizer["MobileImageLayoutHint"]</div>
							</div>
							<div class="row mt-3">
								<div class="col-6 col-md-3">
									@if (Model.Banner.Id != 0)
									{
										<button type="submit" class="btn btn-primary form-control">@Localizer["Update"]</button>
									}
									else
									{
										<button type="submit" class="btn btn-primary form-control">@Localizer["Create"]</button>
									}
								</div>
								<div class="col-6 col-md-3">
									<a asp-controller="Banner" asp-action="Index" class="btn btn-outline-primary border form-control">
										@Localizer["BackToList"]
									</a>
								</div>
							</div>
						</div>
					</form>
				</div>
				<div class="col-12 col-lg-4">
					<div class="border rounded-3 p-3 h-100">
						<h3 class="h5 mb-3 text-primary">@Localizer["PreviewMobile"]</h3>
						<div class="banner-preview__frame @previewMobileAspect @previewLayoutClass @previewColorClass banner-preview--mobile" data-preview-frame="mobile">
							<img class="banner__image" data-preview-mobile-img src="@previewMobileFrameUrl" alt="@previewAlt" @(previewMobileFrameUrl == null ? "hidden" : null) />
							<div class="banner__scrim" aria-hidden="true"></div>
							<div class="banner__content">
								<span class="banner__title" data-preview-mobile-title @(string.IsNullOrWhiteSpace(Model.Banner.Title) ? "hidden" : null)>@Model.Banner.Title</span>
								<span class="banner__hook" data-preview-mobile-hook @(string.IsNullOrWhiteSpace(Model.Banner.Hook) ? "hidden" : null)>@Model.Banner.Hook</span>
								<span class="banner__body" data-preview-mobile-body @(string.IsNullOrWhiteSpace(Model.Banner.Body) ? "hidden" : null)>@Model.Banner.Body</span>
								<span class="banner__cta" data-preview-mobile-cta @(string.IsNullOrWhiteSpace(Model.Banner.CallToAction) ? "hidden" : null)>@Model.Banner.CallToAction</span>
							</div>
						<div class="empty-state rounded-3 p-4 text-center text-muted" data-preview-mobile-empty @(previewMobileFrameUrl == null ? null : "hidden")>
								<i class="bi bi-image fs-2 d-block mb-2" aria-hidden="true"></i>
								@Localizer["NoPreviewImage"]
							</div>
						</div>
						@if (previewCover != null)
						{
							<form method="post" asp-action="DeleteImage" class="d-flex align-items-center gap-2 mb-2 mt-3">
								@Html.AntiForgeryToken()
								<input type="hidden" name="imageId" value="@previewCover.Id" />
								<span class="badge bg-secondary me-auto">@Localizer["CoverImageCurrent"]</span>
								<button type="submit" class="btn btn-outline-danger btn-sm">
									<i class="bi bi-trash-fill"></i> @Localizer["DeleteImage"]
								</button>
							</form>
						}
						@if (previewMobile != null)
						{
							<form method="post" asp-action="DeleteImage" class="d-flex align-items-center gap-2">
								@Html.AntiForgeryToken()
								<input type="hidden" name="imageId" value="@previewMobile.Id" />
								<span class="badge bg-secondary me-auto">@Localizer["MobileImageCurrent"]</span>
								<button type="submit" class="btn btn-outline-danger btn-sm">
									<i class="bi bi-trash-fill"></i> @Localizer["DeleteImage"]
								</button>
							</form>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
	<script src="~/js/bannerPreview.js"></script>
	<script>
		// home-banners A5: the target picker only ever offers options of the chosen kind.
		(function () {
			const kind = document.getElementById('Banner_TargetKind');
			const target = document.getElementById('Banner_TargetId');
			if (!kind || !target) { return; }
			// Optgroups are emitted in fixed order Categories, Collections, Products
			// (see BannerController.PopulateFormData), matching kinds 1, 2, 3.
			const groups = [...target.querySelectorAll('optgroup')];
			function sync() {
				const value = Number(kind.value);
				if (value === 0) { // Store carries no entity
					target.value = '';
					target.disabled = true;
					return;
				}
				target.disabled = false;
				if (groups.length === 0) { return; }
				const keepIndex = value - 1;
				groups.forEach((g, i) => { g.style.display = i === keepIndex ? '' : 'none'; });
				if (target.value && ![...groups[keepIndex].querySelectorAll('option')].some(o => o.value === target.value)) {
					target.value = '';
				}
			}
			kind.addEventListener('change', () => { target.value = ''; sync(); });
			sync();
		})();
	</script>
}
