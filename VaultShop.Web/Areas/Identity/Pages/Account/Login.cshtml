@page
@model LoginModel
<div class="card shadow border-0 mt-4">
	<div class="card-header bg-primary bg-gradient m-lg-0 py-4">
		<div class="row">
			<div class="col-12 text-center">
				<h1 class="h2 py-2 text-secondary">@Localizer["LogIn"] </h1>
			</div>
		</div>
	</div>
	<div class="card-body p-4">
		<div class="row pt-3">
			<div class="col-md-12">
				<section>
					<form id="account" method="post">
						<h2 class="h3 border-bottom pb-3 mb-4 text-center text">@Localizer["UseLocalAccount"]</h2>
						@if (ViewContext.HttpContext.Request.Query["sessionExpired"] == "true")
						{
							<div class="alert alert-warning" role="alert">@Localizer["SessionExpired"]</div>
						}

						<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
						<div class="form-floating shadow mb-3">
							<input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
							<label asp-for="Input.Email" class="form-label">@Localizer["Email"]</label>
							<span asp-validation-for="Input.Email" class="text-danger"></span>
						</div>
						<div class="form-floating shadow mb-3">
							<input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
							<partial name="_PasswordToggle" />
							<label asp-for="Input.Password" class="form-label">@Localizer["Password"]</label>
							<span asp-validation-for="Input.Password" class="text-danger"></span>
						</div>
						<div class="checkbox mb-3">
							<label asp-for="Input.RememberMe" class="form-label">
								<input class="form-check-input" asp-for="Input.RememberMe" />
								@Localizer["RememberMe"]
							</label>
						</div>
						<div>
							<button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["LogIn"]</button>
						</div>
						<div class="d-flex flex-column flex-md-row justify-content-between gap-2 pt-2">
							<p>
								<a id="forgot-password" asp-page="./ForgotPassword">@Localizer["ForgotPassword"]?</a>
							</p>
							<p>
								<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["RegisterAsNewUser"]</a>
							</p>
							<p>
								<a id="resend-confirmation" asp-page="./ResendEmailConfirmation">@Localizer["ResendEmailConfirmation"]</a>
							</p>
						</div>
					</form>
				</section>

				@if (Model.ExternalLogins?.Count > 0)
				{
					<section aria-label="@Localizer["ExternalLoginSectionTitle"]">
						<hr class="my-4" />
						<h2 class="h3 border-bottom pb-3 mb-4 text-center text">@Localizer["ExternalLoginSectionTitle"]</h2>
						<form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
							<div class="payment-method-picker__options">
								@foreach (var provider in Model.ExternalLogins)
								{
									<button type="submit" class="payment-method-picker__card" name="provider" value="@provider.Name" aria-label="@Localizer["ExternalLoginAriaLabel", provider.DisplayName ?? provider.Name]">
										<span class="payment-method-picker__mark" aria-hidden="true">
											@if (provider.Name == "Google")
											{
												<svg viewBox="0 0 48 48" focusable="false">
													<path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
													<path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
													<path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
													<path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571.001-.001.002-.001.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
												</svg>
											}
											else
											{
												<svg viewBox="0 0 48 48" focusable="false">
													<rect width="48" height="48" rx="12" fill="#d4a017" />
													<path fill="#fff" d="M24 14c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10Zm0 4.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Zm0 12.5c-3.3 0-6.3-1.5-8.2-3.9.4-2.7 5.1-4.1 8.2-4.1s7.8 1.4 8.2 4.1c-1.9 2.4-4.9 3.9-8.2 3.9Z" />
												</svg>
											}
										</span>
										<span class="payment-method-picker__label">@Localizer["ExternalLoginButtonText", provider.DisplayName ?? provider.Name]</span>
									</button>
								}
							</div>
						</form>
					</section>
				}

			</div>

		</div>

	</div>

</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
