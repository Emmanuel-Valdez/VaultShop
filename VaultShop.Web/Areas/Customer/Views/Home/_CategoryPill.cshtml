@model VaultShop.Models.ViewModels.CategoryPillVM
@{
    var keywordId = Context.Request.Query["keywordId"].ToString();
    var searchString = Context.Request.Query["searchString"].ToString();
    var cleanedKeyword = string.IsNullOrWhiteSpace(keywordId) ? null : keywordId;
    var cleanedSearch = string.IsNullOrWhiteSpace(searchString) ? null : searchString;
    var slug = string.IsNullOrWhiteSpace(Model.Slug) ? null : Model.Slug;
    var firstChar = Model.Name.Trim().FirstOrDefault();
    var fallback = char.IsLetter(firstChar) ? firstChar.ToString().ToUpperInvariant() : "#";
}
@* ponytail: re-themed to editorial chip (72px circle, 6.5rem card, no count) — uses collection-chip family, alias category-pill* for test compat *@
<div class="collection-chip category-pill@(Model.IsActive ? " active btn-primary" : " btn-outline-primary")">
    <a asp-action="Search"
       asp-route-categoryId="@Model.Id"
       asp-route-keywordId="@cleanedKeyword"
       asp-route-slug="@slug"
       asp-route-searchString="@cleanedSearch"
       class="collection-chip__link category-pill"
       aria-current="@(Model.IsActive ? "true" : null)">
        <span class="collection-chip__image category-pill__image" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="" loading="lazy" class="category-pill__thumb" />
            }
            else
            {
                <span class="collection-chip__fallback category-pill__fallback">@fallback</span>
            }
        </span>
        <span class="collection-chip__name category-pill__label">@Model.Name</span>
    </a>
    @if (Model.IsActive)
    {
        <a asp-action="Search"
           asp-route-keywordId="@cleanedKeyword"
           asp-route-slug="@slug"
           asp-route-searchString="@cleanedSearch"
           class="collection-chip__remove"
           aria-label='@Localizer["RemoveCategoryFilter", Model.Name]'
           title='@Localizer["RemoveCategoryFilter", Model.Name]'>
            <span aria-hidden="true">&times;</span>
        </a>
    }
</div>