@model ShoppingCartVM
@using System.Globalization
@using VaultShop.Web.Services.Pricing
@using VaultShop.Web.Services.Checkout
@{
	var domicile = ViewData["DomicilePicker"] as DomicilePickerVM ?? new DomicilePickerVM();
	var shipping = ViewData["ShippingQuote"] as ICheckoutService.ShippingQuote;
	var isCompanyViewer = User.IsInRole(SD.Role_Company);
	var effectiveCharge = domicile.SelectedModality == SD.DeliveryTypeVendorPickup ? 0m : (shipping?.Charge ?? 0m);
	var isFreeShipping = shipping?.QualifiesForFreeShipping == true;
	var showShippingRow = !isCompanyViewer && (effectiveCharge > 0 || isFreeShipping);
	var argentinaToday = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, OfferTimeZone.ArgentinaZone));
	var vendorPickupDetails = string.Format(CultureInfo.CurrentCulture, Localizer["VendorPickupWindow"].Value,
		argentinaToday.ToString("d", CultureInfo.CurrentCulture), argentinaToday.AddDays(7).ToString("d", CultureInfo.CurrentCulture));
}
<form method="post" class="checkout-summary">
	@Html.AntiForgeryToken()
	<br />
	<div class="container">
		<div class="card shadow border-0 checkout-summary__card">

			<div class="card-header bg-secondary bg-gradient ml-0 py-4 border-0">
				<div class="row px-4 align-items-center g-3">
					<div class="col-12 col-md-7">
						<h1 class="h3 mb-0 text-primary">
							@Localizer["Title"]
						</h1>
					</div>
					<div class="col-12 col-md-5 text-md-end">
						<a asp-area="Customer" asp-Controller="Cart" asp-action="Index" class="btn btn-outline-primary btn-sm">@Localizer["BackToCart"]</a>
					</div>
				</div>
			</div>
			<div class="card-body p-4 p-lg-5">
				 <input asp-for="@Model.OrderHeader.ApplicationUserId" hidden />
				<div class="container-fluid rounded p-0">
					<div class="row g-4">
						<div class="col-12 col-lg-6 pb-4">
							<h2 class="h5 mb-3 text-primary">@Localizer["ShippingDetails"]</h2>
							<div class="form-floating mb-3">
								<input asp-for="OrderHeader.Name" class="form-control" placeholder=" " />
								<label asp-for="OrderHeader.Name">@Localizer["UserName"]</label>
								<span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
							</div>
							<div class="form-floating mb-3">
								<input asp-for="OrderHeader.PhoneNumber" class="form-control" placeholder=" " />
								<label asp-for="OrderHeader.PhoneNumber">@Localizer["UserPhoneNumber"]</label>
								<span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
							</div>
							<div class="form-floating mb-3">
								<input asp-for="OrderHeader.StreetAddress" class="form-control" placeholder=" " />
								<label asp-for="OrderHeader.StreetAddress">@Localizer["UserStreetAddress"]</label>
								<span asp-validation-for="OrderHeader.StreetAddress" class="text-danger small"></span>
							</div>
							<div class="row g-3">
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<select id="domicileProvince" name="OrderHeader.State" class="form-select" autocomplete="off">
											<option value="">@Localizer["SelectProvince"]</option>
											@foreach (var province in domicile.Provinces)
											{
												<option value="@province.Name" data-code="@province.Code" selected="@(string.Equals(province.Name, domicile.SelectedProvinceName, StringComparison.OrdinalIgnoreCase))">@province.Name</option>
											}
										</select>
										<label for="domicileProvince">@Localizer["UserState"]</label>
									</div>
									<span asp-validation-for="OrderHeader.State" class="text-danger small"></span>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<select asp-for="OrderHeader.City" id="OrderHeader_City" class="form-select" autocomplete="off" disabled="@(domicile.Localities.Count == 0)">
											<option value="">@Localizer["SelectLocality"]</option>
											@foreach (var locality in domicile.Localities)
											{
												<option value="@locality" selected="@(string.Equals(locality, domicile.SelectedLocality, StringComparison.OrdinalIgnoreCase))">@locality</option>
											}
										</select>
										<label asp-for="OrderHeader.City">@Localizer["UserCity"]</label>
									</div>
									<span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="OrderHeader.PostalCode" class="form-control" placeholder=" " />
										<label asp-for="OrderHeader.PostalCode">@Localizer["UserPostalCode"]</label>
										<span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-5 offset-lg-1">
							<h2 class="h5 mb-3 text-primary">@Localizer["OrderSummary"]</h2>
							 <ul class="list-group mb-3 shadow-sm">
								@foreach (var details in Model.ShoppingCartList)
								{
									
									<li class="list-group-item d-flex justify-content-between">
										<div>
											<h6 class="my-0">@details.Product.Name</h6>
											<partial name="_VariantLabel" model="details" />
											<small class="text-muted">@Localizer["Quantity"]: @details.Count</small>
											@if (details.DiscountAmount > 0)
											{
												<div>
													<s class="text-muted small">@((details.OriginalPrice * details.Count).ToString("c"))</s>
													<span class="badge bg-success ms-1">@DiscountMotives.Badge(details.DiscountMotive, Localizer["OfferBadge"].Value, Localizer["CouponBadge"].Value)</span>
												</div>
											}
										</div>
										<span class="fw-semibold">@((details.Price * details.Count).ToString("c")) </span>
									</li>
								}

								@if (!string.IsNullOrEmpty(Model.OrderHeader.CouponCode))
								{
									<li class="list-group-item d-flex justify-content-between">
										<span>@Localizer["Coupon"]: @Model.OrderHeader.CouponCode</span>
									</li>
								}
								@if (Model.OrderHeader.DiscountTotal > 0)
								{
									<li class="list-group-item d-flex justify-content-between">
										<span>@Localizer["Subtotal"]</span>
										<span>@((Model.OrderHeader.OrderTotal + Model.OrderHeader.DiscountTotal + Model.OrderHeader.PaymentDiscountTotal).ToString("c"))</span>
									</li>
									<li class="list-group-item d-flex justify-content-between text-success">
										<span>@Localizer["Discounts"]</span>
										<span>-@Model.OrderHeader.DiscountTotal.ToString("c")</span>
									</li>
								}
								@if (Model.OrderHeader.PaymentDiscountTotal > 0)
								{
									<li id="paymentDiscountRow" class="list-group-item d-flex justify-content-between text-success">
										<span id="paymentDiscountMotive">@Model.OrderHeader.PaymentDiscountMotive</span>
										<span id="paymentDiscountAmount">-@Model.OrderHeader.PaymentDiscountTotal.ToString("c")</span>
									</li>
								}

								<li id="shippingRow" class="list-group-item d-flex justify-content-between @(showShippingRow ? "" : "d-none")">
									<span id="shippingLabel">@(isFreeShipping ? Localizer["FreeShippingLine"].Value : Localizer["ShippingLine"].Value)</span>
									<span>
										<s id="shippingStandard" class="text-muted small @(isFreeShipping ? "" : "d-none")">@((shipping?.StandardAmount ?? 0m).ToString("c"))</s>
										<span id="shippingAmount" class="@(effectiveCharge > 0 ? "" : "d-none")">@effectiveCharge.ToString("c")</span>
									</span>
								</li>

								<li id="orderTotalRow" class="list-group-item d-flex justify-content-between bg-secondary">
									<strong class="text-primary">@Localizer["Total"] </strong>
									<strong class="text-primary" id="orderTotalValue">@Model.OrderHeader.OrderTotal.ToString("C")</strong>
									
								</li>

							</ul>
						</div>
					</div>
				<div class="row g-4 mt-1">
						<div class="col-12">
							@if (!isCompanyViewer)
							{
								<h2 class="h5 mb-3 text-primary" id="deliveryMethodHeading">@Localizer["DeliveryMethod"]</h2>
								<svg class="d-none" aria-hidden="true" focusable="false">
									<symbol id="checkoutMotorcycleIcon" viewBox="0 0 24 24">
										<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7">
											<circle cx="5" cy="18" r="3" />
											<circle cx="19" cy="18" r="3" />
											<path d="m8 18 2.5-6h4l4.5 6M10.5 12 8 10H4l-2 3m7 1h4m3-2 2-4 2 1m-2-1 1-2h2M10.5 12l2-2h3l2 2m-8 2-2 1-1 3m9-6 2 6" />
										</g>
									</symbol>
								</svg>
								<div id="deliveryModalities" class="checkout-delivery-options" role="radiogroup" aria-labelledby="deliveryMethodHeading"
									data-url="@Url.Action("DeliveryModalities", "Cart", new { area = "Customer" })"
									data-selected="@domicile.SelectedModality">
									@if (domicile.Modalities.Count == 0)
									{
										<p id="deliveryModalitiesHint" class="text-muted small mb-0">@Localizer["DeliveryModalityHint"]</p>
									}
									else
									{
										foreach (var modality in domicile.Modalities)
										{
											<label class="checkout-delivery-option">
												<input class="form-check-input" type="radio" name="OrderHeader.DeliveryType" id="delivery_@modality.Code" value="@modality.Code" checked="@(modality.Code == domicile.SelectedModality)" />
												<span class="checkout-delivery-option__content">
													<span class="checkout-delivery-option__main">
														<span class="checkout-delivery-option__title">
										@if (modality.Code == SD.DeliveryTypeMotorcycle)
										{
											<svg class="checkout-delivery-option__icon" aria-hidden="true" focusable="false"><use href="#checkoutMotorcycleIcon"></use></svg>
										}
															@modality.Label
														</span>
													@if (modality.Code == SD.DeliveryTypeVendorPickup)
													{
														<span class="checkout-delivery-option__details">@vendorPickupDetails</span>
													}
													</span>
												@if (modality.Code == SD.DeliveryTypeVendorPickup)
												{
													<span class="checkout-delivery-option__price">@Localizer["Free"]</span>
												}
												</span>
											</label>
										}
									}
								</div>
								<span asp-validation-for="OrderHeader.DeliveryType" class="text-danger small"></span>
							}
							<h2 class="h5 mb-1 mt-3 text-primary">@Localizer["PickupHeading"]</h2>
							<div id="branchPickerWrap" class="@(domicile.SelectedModality != SD.DeliveryTypeMotorcycle && domicile.SelectedModality != SD.DeliveryTypeVendorPickup ? "" : "d-none")">
								<partial name="_BranchCascadePicker" model='ViewData["BranchCascadePicker"] as BranchCascadePickerVM' />
								<span asp-validation-for="OrderHeader.PickupAgencyCode" class="text-danger small"></span>
							</div>
						</div>
					</div>
                    @if (!User.IsInRole(SD.Role_Company))
                    {
                        var paymentDiscountPercents = ViewData["PaymentDiscountPercents"] as Dictionary<string, decimal> ?? new();
                        var paymentMethodLabels = new Dictionary<string, string>
                        {
                            [SD.PaymentMethodStripe] = Localizer["PayWithStripe"].Value,
                            [SD.PaymentMethodBankTransfer] = Localizer["PayByBankTransfer"].Value,
                            [SD.PaymentMethodMercadoPago] = Localizer["PayWithMercadoPago"].Value,
                        };
                        // descuento-medio-de-pago �2: localized offer note per method (e.g. "-10% paying by bank transfer").
                        string Pct(decimal p) => p == Math.Truncate(p) ? ((int)p).ToString() : p.ToString("0.##");
                        var paymentDiscountNotes = paymentDiscountPercents
                            .Where(kv => kv.Value > 0 && paymentMethodLabels.ContainsKey(kv.Key))
                            .ToDictionary(kv => kv.Key, kv => string.Format(Localizer["PaymentMethodOfferNote"].Value, Pct(kv.Value), paymentMethodLabels[kv.Key]));
                        var paymentMethodPicker = new PaymentMethodPickerVM
                        {
                            FieldName = "OrderHeader.PaymentMethod",
                            IdPrefix = "checkoutPaymentMethod",
                            PaymentMethodLegend = Localizer["PaymentMethod"].Value,
                            StripeEnabled = ViewData["StripeEnabled"] is true,
                            BankTransferEnabled = ViewData["BankTransferEnabled"] is true,
                            MercadoPagoEnabled = ViewData["MercadoPagoEnabled"] is true,
                            SelectedPaymentMethod = Model.OrderHeader.PaymentMethod ?? string.Empty,
                            PayWithStripeLabel = Localizer["PayWithStripe"].Value,
                            PayByBankTransferLabel = Localizer["PayByBankTransfer"].Value,
                            PayWithMercadoPagoLabel = Localizer["PayWithMercadoPago"].Value,
                            BankTransferCbuLabel = Localizer["BankTransferCbuLabel"].Value,
                            BankTransferAliasLabel = Localizer["BankTransferAliasLabel"].Value,
                            BankTransferRecipientNameLabel = Localizer["BankTransferRecipientNameLabel"].Value,
                            BankTransferBankNameLabel = Localizer["BankTransferBankNameLabel"].Value,
                            BankTransferCbu = ViewData["BankTransferCbu"] as string ?? string.Empty,
                            BankTransferAlias = ViewData["BankTransferAlias"] as string ?? string.Empty,
                            BankTransferRecipientName = ViewData["BankTransferRecipientName"] as string ?? string.Empty,
                            BankTransferBankName = ViewData["BankTransferBankName"] as string ?? string.Empty,
                            PaymentDiscountPercents = paymentDiscountPercents,
                            PaymentDiscountNotes = paymentDiscountNotes
                        };

                        <div class="row g-4 mt-2">
                            <div class="col-12">
                                <h2 class="h5 mb-3 text-primary">@Localizer["PaymentMethod"]</h2>
                                <partial name="_PaymentMethodPicker" model="paymentMethodPicker" />
                            </div>
                        </div>
                    }
				</div>
			</div>
			<div class="card-footer bg-white border-0 p-4 p-lg-5 pt-0">
				<div class="row align-items-center g-3">
					@if (ViewData["ShowDemoNotice"] is true)
					{
						<div class="col-12 mb-3">
							<div class="checkout-demo-notice">
								<div class="checkout-demo-notice__icon" aria-hidden="true">
									<i class="bi bi-shield-exclamation"></i>
								</div>
								<div>
									<strong>@Localizer["DemoEnvironmentTitle"]</strong>
									<div>@Localizer["DemoEnvironmentMessage"]</div>
								</div>
							</div>
						</div>
					}
					<div class="col-12 col-md-8 pt-2">
						<p class="text-muted small mb-0">
							@Localizer["EstimateArrivalDate"] :
							@DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()

						</p>
					</div>
					<div class="col-12 col-md-4">
						<button type="submit" id="placeOrderBtn" value="Place Order" class="btn btn-primary form-control @(Model.OrderHeader.OrderTotal == 0 ? "disabled" : "")"> 
							@Localizer["PlaceOrder"]
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
	<script>
		// descuento-medio-de-pago �2 + envio-gratis-o-cargo �4: choosing a payment method or
		// delivery modality re-evaluates the summary server-side (discount row, shipping line, total).
		(function () {
			var totalsUrl = '@Url.Action("SummaryTotals", "Cart", new { area = "Customer" })';
			var total = document.getElementById('orderTotalValue');
			var paymentMethodValue = document.getElementById('checkoutPaymentMethodValue');
			var modalitiesRoot = document.getElementById('deliveryModalities');
			var modalitiesUrl = modalitiesRoot ? modalitiesRoot.dataset.url : null;
			var provinceSelect = document.getElementById('domicileProvince');
			var localitySelect = document.getElementById('OrderHeader_City');
			var branchWrap = document.getElementById('branchPickerWrap');
			var branchPicker = document.getElementById('branchPicker');
			var shippingRow = document.getElementById('shippingRow');
			var shippingLabel = document.getElementById('shippingLabel');
			var shippingAmount = document.getElementById('shippingAmount');
			var shippingStandard = document.getElementById('shippingStandard');
			var modalityHint = @Json.Serialize(Localizer["DeliveryModalityHint"].Value);
			var vendorPickupDetails = @Json.Serialize(vendorPickupDetails);
			var vendorPickupFreeLabel = @Json.Serialize(Localizer["Free"].Value);

			function selectedModality() {
				var checked = document.querySelector('input[name="OrderHeader.DeliveryType"]:checked');
				return checked ? checked.value : '';
			}

			function selectedPaymentMethod() {
				return paymentMethodValue ? paymentMethodValue.value : '';
			}

			function provinceCode() {
				var option = provinceSelect && provinceSelect.selectedOptions[0];
				return option && option.dataset.code ? option.dataset.code : '';
			}

			function ensureRow() {
				var existing = document.getElementById('paymentDiscountRow');
				if (existing) return existing;
				var totalRow = document.getElementById('orderTotalRow');
				if (!totalRow) return null;
				var li = document.createElement('li');
				li.id = 'paymentDiscountRow';
				li.className = 'list-group-item d-flex justify-content-between text-success';
				li.innerHTML = '<span id="paymentDiscountMotive"></span><span id="paymentDiscountAmount"></span>';
				totalRow.parentNode.insertBefore(li, totalRow);
				return li;
			}

			function updatePaymentDiscount(data) {
				if (data.hasPaymentDiscount) {
					var row = ensureRow();
					if (!row) return;
					row.classList.remove('d-none');
					document.getElementById('paymentDiscountMotive').textContent = data.paymentDiscountMotive;
					document.getElementById('paymentDiscountAmount').textContent = '-' + data.paymentDiscountTotal;
				} else {
					var current = document.getElementById('paymentDiscountRow');
					if (current) current.classList.add('d-none');
				}
			}

			function updateShipping(data) {
				if (!shippingRow) return;
				shippingRow.classList.toggle('d-none', !data.showShippingRow);
				if (!data.showShippingRow) return;
				if (shippingLabel) shippingLabel.textContent = data.shippingLabel;
				if (shippingAmount) {
					shippingAmount.textContent = data.shippingCharge;
					shippingAmount.classList.toggle('d-none', !data.hasShippingCharge);
				}
				if (shippingStandard) {
					shippingStandard.textContent = data.shippingStandard;
					shippingStandard.classList.toggle('d-none', !data.isFreeShipping);
				}
			}

			function applyModality(code) {
				if (!branchPicker) return;
				var isPickup = code === '@SD.DeliveryTypePickup';
				branchPicker.dataset.requiresBranch = isPickup ? 'true' : 'false';
				branchPicker.dataset.required = isPickup ? 'true' : 'false';
				branchPicker.querySelectorAll('input[type=radio][name="OrderHeader.PickupAgencyCode"]').forEach(function (radio) {
					radio.required = isPickup;
					if (!isPickup) radio.checked = false;
				});
				if (branchWrap) branchWrap.classList.toggle('d-none', !isPickup);
				// Re-run the picker's submit gate (private) through its change listener.
				var list = branchPicker.querySelector('.list-group');
				if (list) list.dispatchEvent(new Event('change', { bubbles: true }));
			}

			function renderModalities(items) {
				if (!modalitiesRoot) return;
				modalitiesRoot.querySelectorAll('.checkout-delivery-option, #deliveryModalitiesHint').forEach(function (node) { node.remove(); });
				if (!items || items.length === 0) {
					var hint = document.createElement('p');
					hint.id = 'deliveryModalitiesHint';
					hint.className = 'text-muted small mb-0';
					hint.textContent = modalityHint;
					modalitiesRoot.appendChild(hint);
					modalitiesRoot.dataset.selected = '';
					applyModality('');
					return;
				}

				var selected = modalitiesRoot.dataset.selected || '';
				var codes = items.map(function (item) { return item.code; });
				if (codes.indexOf(selected) === -1) {
					selected = codes.indexOf('@SD.DeliveryTypePickup') !== -1 ? '@SD.DeliveryTypePickup' : items[0].code;
				}

				items.forEach(function (item) {
					var wrap = document.createElement('label');
					wrap.className = 'checkout-delivery-option';
					var input = document.createElement('input');
					input.className = 'form-check-input';
					input.type = 'radio';
					input.name = 'OrderHeader.DeliveryType';
					input.id = 'delivery_' + item.code;
					input.value = item.code;
					input.checked = item.code === selected;
					var content = document.createElement('span');
					content.className = 'checkout-delivery-option__content';
					var main = document.createElement('span');
					main.className = 'checkout-delivery-option__main';
					var title = document.createElement('span');
					title.className = 'checkout-delivery-option__title';
					if (item.code === '@SD.DeliveryTypeMotorcycle') {
						var icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
						icon.classList.add('checkout-delivery-option__icon');
						icon.setAttribute('aria-hidden', 'true');
						icon.setAttribute('focusable', 'false');
						var iconUse = document.createElementNS('http://www.w3.org/2000/svg', 'use');
						iconUse.setAttribute('href', '#checkoutMotorcycleIcon');
						icon.appendChild(iconUse);
						title.appendChild(icon);
					}
					title.appendChild(document.createTextNode(item.label));
					main.appendChild(title);
					if (item.code === '@SD.DeliveryTypeVendorPickup') {
						var details = document.createElement('span');
						details.className = 'checkout-delivery-option__details';
						details.textContent = vendorPickupDetails;
						main.appendChild(details);
						var free = document.createElement('span');
						free.className = 'checkout-delivery-option__price';
						free.textContent = vendorPickupFreeLabel;
						content.appendChild(main);
						content.appendChild(free);
					} else {
						content.appendChild(main);
					}
					wrap.appendChild(input);
					wrap.appendChild(content);
					modalitiesRoot.appendChild(wrap);
				});
				modalitiesRoot.dataset.selected = selected;
				applyModality(selected);
			}

			function refreshTotals() {
				var url = totalsUrl
					+ '?paymentMethod=' + encodeURIComponent(selectedPaymentMethod())
					+ '&modality=' + encodeURIComponent(selectedModality());
				fetch(url, { headers: { 'Accept': 'application/json' } })
					.then(function (res) { return res.ok ? res.json() : null; })
					.then(function (data) {
						if (!data) return;
						if (total) total.textContent = data.orderTotal;
						updatePaymentDiscount(data);
						updateShipping(data);
					});
			}

			function loadModalities() {
				if (!modalitiesUrl || !localitySelect || !localitySelect.value || !provinceCode()) {
					renderModalities([]);
					return;
				}
				var code = provinceCode();
				var locality = localitySelect.value;
				fetch(modalitiesUrl + '?provinceCode=' + encodeURIComponent(code) + '&locality=' + encodeURIComponent(locality),
					{ headers: { 'Accept': 'application/json' } })
					.then(function (res) { return res.ok ? res.json() : []; })
					.then(function (items) {
						if (localitySelect.value !== locality || provinceCode() !== code) return;
						renderModalities(items);
						refreshTotals();
					});
			}

			if (localitySelect) localitySelect.addEventListener('change', loadModalities);
			if (provinceSelect) provinceSelect.addEventListener('change', function () { renderModalities([]); });
			if (modalitiesRoot) {
				modalitiesRoot.addEventListener('change', function (e) {
					if (!e.target || e.target.name !== 'OrderHeader.DeliveryType') return;
					modalitiesRoot.dataset.selected = e.target.value;
					applyModality(e.target.value);
					refreshTotals();
				});
			}
			document.querySelectorAll('input[name="checkoutPaymentMethodChoice"]').forEach(function (radio) {
				radio.addEventListener('change', refreshTotals);
			});

			var initial = selectedModality();
			if (initial) {
				applyModality(initial);
				// envio-gratis-o-cargo: keep totals in sync on load (failed POST re-render must reflect the posted modality).
				refreshTotals();
			}
		})();
