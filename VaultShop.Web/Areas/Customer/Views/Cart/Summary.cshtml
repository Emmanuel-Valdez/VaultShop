@model ShoppingCartVM
<form method="post" class="checkout-summary">
	@Html.AntiForgeryToken()
	<br />
	<div class="container">
		<div class="card shadow border-0 checkout-summary__card">

			<div class="card-header bg-secondary bg-gradient ml-0 py-4 border-0">
				<div class="row px-4 align-items-center g-3">
					<div class="col-12 col-md-7">
						<h1 class="h3 mb-0 text-primary">
							@Localizer["Title"]
						</h1>
					</div>
					<div class="col-12 col-md-5 text-md-end">
						<a asp-area="Customer" asp-Controller="Cart" asp-action="Index" class="btn btn-outline-primary btn-sm">@Localizer["BackToCart"]</a>
					</div>
				</div>
			</div>
			<div class="card-body p-4 p-lg-5">
				 <input asp-for="@Model.OrderHeader.ApplicationUserId" hidden />
				<div class="container-fluid rounded p-0">
					<div class="row g-4">
						<div class="col-12 col-lg-6 pb-4">
							<h2 class="h5 mb-3 text-primary">@Localizer["ShippingDetails"]</h2>
							<div class="form-floating mb-3">
								<input asp-for="OrderHeader.Name" class="form-control" placeholder=" " />
								<label asp-for="OrderHeader.Name">@Localizer["UserName"]</label>
								<span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
							</div>
							<div class="form-floating mb-3">
								<input asp-for="OrderHeader.PhoneNumber" class="form-control" placeholder=" " />
								<label asp-for="OrderHeader.PhoneNumber">@Localizer["UserPhoneNumber"]</label>
								<span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
							</div>
							<div class="form-floating mb-3">
								<input asp-for="OrderHeader.StreetAddress" class="form-control" placeholder=" " />
								<label asp-for="OrderHeader.StreetAddress">@Localizer["UserStreetAddress"]</label>
								<span asp-validation-for="OrderHeader.StreetAddress" class="text-danger small"></span>
							</div>
							<div class="row g-3">
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="OrderHeader.City" class="form-control" placeholder=" " />
										<label asp-for="OrderHeader.City">@Localizer["UserCity"]</label>
										<span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="OrderHeader.State" class="form-control" placeholder=" " />
										<label asp-for="OrderHeader.State">@Localizer["UserState"]</label>
										<span asp-validation-for="OrderHeader.State" class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12 col-md-6">
									<div class="form-floating">
										<input asp-for="OrderHeader.PostalCode" class="form-control" placeholder=" " />
										<label asp-for="OrderHeader.PostalCode">@Localizer["UserPostalCode"]</label>
										<span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-5 offset-lg-1">
							<h2 class="h5 mb-3 text-primary">@Localizer["OrderSummary"]</h2>
							 <ul class="list-group mb-3 shadow-sm">
								@foreach (var details in Model.ShoppingCartList)
								{
									
									<li class="list-group-item d-flex justify-content-between">
										<div>
											<h6 class="my-0">@details.Product.Name</h6>
											<small class="text-muted">@Localizer["Quantity"]: @details.Count</small>
										</div>
										<span class="fw-semibold">@((details.Price * details.Count).ToString("c")) </span>
									</li>
								}

								<li class="list-group-item d-flex justify-content-between bg-secondary">
									<strong class="text-primary">@Localizer["Total"] </strong>
									<strong class="text-primary">@Model.OrderHeader.OrderTotal.ToString("C")</strong>
									
								</li>

							</ul>
						</div>
					</div>
					<div class="row g-4 mt-1">
						<div class="col-12">
							<div role="group" aria-labelledby="pickupAgencyHeading">
								<h2 id="pickupAgencyHeading" class="h5 mb-1 text-primary">@Localizer["PickupHeading"]</h2>
								<p class="text-success fw-semibold mb-3">@Localizer["PickupFreeShipping"]</p>
							<button type="button" id="searchAgenciesBtn" class="btn btn-outline-primary btn-sm">@Localizer["SearchBranches"]</button>
							<span id="searchAgenciesStatus" class="ms-2 small text-muted" role="status" aria-live="polite"></span>
							<div id="agencyCandidates" class="list-group mt-3">
								@{
									var serverCandidates = ViewData["AgencyCandidates"] as IReadOnlyList<VaultShop.Web.Services.Shipping.AgencyCandidate>;
									var pickedAgencyCode = Model.OrderHeader.PickupAgencyCode;
								}
								@if (serverCandidates is not null)
								{
									foreach (var candidate in serverCandidates)
									{
										var radioId = "agency_" + candidate.Code;
										var isPicked = !string.IsNullOrEmpty(pickedAgencyCode) && string.Equals(pickedAgencyCode, candidate.Code, StringComparison.OrdinalIgnoreCase);
										<label class="list-group-item d-flex gap-2" for="@radioId">
											<input type="radio" name="OrderHeader.PickupAgencyCode" value="@candidate.Code" id="@radioId" required class="form-check-input mt-1" @(isPicked ? "checked" : "") />
											<span>
												<strong>@candidate.Name</strong><br />
												<small class="text-muted">@candidate.Address, @candidate.Locality, @candidate.Province</small>
												@if (candidate.DistanceKm.HasValue)
												{
													<text> </text><small class="text-muted">(@(Math.Round(candidate.DistanceKm.Value, 1)) km)</small>
												}
											</span>
										</label>
									}
								}
							</div>
								<span asp-validation-for="OrderHeader.PickupAgencyCode" class="text-danger small"></span>
							</div>
						</div>
					</div>
                    @if (!User.IsInRole(SD.Role_Company))
                    {
                        var paymentMethodPicker = new PaymentMethodPickerVM
                        {
                            FieldName = "OrderHeader.PaymentMethod",
                            IdPrefix = "checkoutPaymentMethod",
                            PaymentMethodLegend = Localizer["PaymentMethod"].Value,
                            StripeEnabled = ViewData["StripeEnabled"] is true,
                            BankTransferEnabled = ViewData["BankTransferEnabled"] is true,
                            MercadoPagoEnabled = ViewData["MercadoPagoEnabled"] is true,
                            SelectedPaymentMethod = Model.OrderHeader.PaymentMethod ?? string.Empty,
                            PayWithStripeLabel = Localizer["PayWithStripe"].Value,
                            PayByBankTransferLabel = Localizer["PayByBankTransfer"].Value,
                            PayWithMercadoPagoLabel = Localizer["PayWithMercadoPago"].Value,
                            BankTransferCbuLabel = Localizer["BankTransferCbuLabel"].Value,
                            BankTransferAliasLabel = Localizer["BankTransferAliasLabel"].Value,
                            BankTransferRecipientNameLabel = Localizer["BankTransferRecipientNameLabel"].Value,
                            BankTransferBankNameLabel = Localizer["BankTransferBankNameLabel"].Value,
                            BankTransferCbu = ViewData["BankTransferCbu"] as string ?? string.Empty,
                            BankTransferAlias = ViewData["BankTransferAlias"] as string ?? string.Empty,
                            BankTransferRecipientName = ViewData["BankTransferRecipientName"] as string ?? string.Empty,
                            BankTransferBankName = ViewData["BankTransferBankName"] as string ?? string.Empty
                        };

                        <div class="row g-4 mt-2">
                            <div class="col-12">
                                <h2 class="h5 mb-3 text-primary">@Localizer["PaymentMethod"]</h2>
                                <partial name="_PaymentMethodPicker" model="paymentMethodPicker" />
                            </div>
                        </div>
                    }
				</div>
			</div>
			<div class="card-footer bg-white border-0 p-4 p-lg-5 pt-0">
				<div class="row align-items-center g-3">
					@if (ViewData["ShowDemoNotice"] is true)
					{
						<div class="col-12 mb-3">
							<div class="checkout-demo-notice">
								<div class="checkout-demo-notice__icon" aria-hidden="true">
									<i class="bi bi-shield-exclamation"></i>
								</div>
								<div>
									<strong>@Localizer["DemoEnvironmentTitle"]</strong>
									<div>@Localizer["DemoEnvironmentMessage"]</div>
								</div>
							</div>
						</div>
					}
					<div class="col-12 col-md-8 pt-2">
						<p class="text-muted small mb-0">
							@Localizer["EstimateArrivalDate"] :
							@DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()

						</p>
					</div>
					<div class="col-12 col-md-4">
						<button type="submit" id="placeOrderBtn" value="Place Order" class="btn btn-primary form-control @(Model.OrderHeader.OrderTotal == 0 ? "disabled" : "")"> 
							@Localizer["PlaceOrder"]
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
	<script>
		(() => {
			const searchBtn = document.getElementById('searchAgenciesBtn');
			const status = document.getElementById('searchAgenciesStatus');
			const list = document.getElementById('agencyCandidates');
			const submitBtn = document.getElementById('placeOrderBtn');
			const val = (id) => document.getElementById(id)?.value?.trim() ?? '';
			let currentSearch = null;

			const updateSubmitGate = () => {
				if (!submitBtn || !list) return;
				submitBtn.disabled = !list.querySelector('input[name="OrderHeader.PickupAgencyCode"]:checked');
			};

			const renderCandidates = (items) => {
				list.innerHTML = '';
				for (const item of items) {
					const id = 'agency_' + item.code;
					const label = document.createElement('label');
					label.className = 'list-group-item d-flex gap-2';
					label.setAttribute('for', id);
					const radio = document.createElement('input');
					radio.type = 'radio';
					radio.name = 'OrderHeader.PickupAgencyCode';
					radio.value = item.code;
					radio.id = id;
					radio.required = true;
					radio.className = 'form-check-input mt-1';
					const body = document.createElement('span');
					const distance = item.distanceKm === null || item.distanceKm === undefined ? '' : ' <small class="text-muted">(' + item.distanceKm + ' km)</small>';
					body.innerHTML = '<strong></strong><br><small class="text-muted"></small>' + distance;
					body.querySelector('strong').textContent = item.name;
					body.querySelector('small').textContent = item.address + ', ' + item.locality + ', ' + item.province;
					label.appendChild(radio);
					label.appendChild(body);
					list.appendChild(label);
				}
				updateSubmitGate();
			};

			// Progressive enhancement: no-JS leaves submit enabled, server validates.
			updateSubmitGate();
			list.addEventListener('change', (e) => {
				if (e.target?.name === 'OrderHeader.PickupAgencyCode') updateSubmitGate();
			});

			searchBtn.addEventListener('click', async () => {
				const street = val('OrderHeader_StreetAddress');
				const state = val('OrderHeader_State');
				if (!street || !state) {
					status.textContent = '@Localizer["EnterAddressBeforeSearch"]';
					return;
				}
				currentSearch?.abort();
				const controller = new AbortController();
				currentSearch = controller;
				searchBtn.disabled = true;
				searchBtn.setAttribute('aria-disabled', 'true');
				status.textContent = '@Localizer["SearchingBranches"]';
				list.innerHTML = '';
				updateSubmitGate();
				let items = [];
				try {
					const params = new URLSearchParams({
						street: street,
						city: val('OrderHeader_City'),
						state: state
					});
					const res = await fetch('@Url.Action("GetNearestAgencies", "Cart", new { area = "Customer" })?' + params.toString(), { headers: { 'Accept': 'application/json' }, signal: controller.signal });
					if (res.ok) items = await res.json();
				} catch (e) {
					if (e?.name === 'AbortError') return;
					// network failure renders as no-results below
				} finally {
					if (currentSearch === controller) {
						searchBtn.disabled = false;
						searchBtn.removeAttribute('aria-disabled');
					}
				}
				if (controller.signal.aborted) return;
				if (!Array.isArray(items) || items.length === 0) {
					status.textContent = '@Localizer["NoBranchesFound"]';
					return;
				}
				status.textContent = '';
				renderCandidates(items);
			});
		})();
	</script>
}


