<button type="button" class="btn nav-link text-secondary px-2 d-flex align-items-center theme-toggle" data-theme-toggle aria-pressed="false" aria-label="@(Localizer["SwitchToTheme", Localizer["Dark"].Value])" data-label-dark="@(Localizer["SwitchToTheme", Localizer["Dark"].Value])" data-label-light="@(Localizer["SwitchToTheme", Localizer["Light"].Value])">
	<svg class="theme-toggle__icon theme-toggle__icon--sun" width="1.25em" height="1.25em" aria-hidden="true" fill="currentColor"><use href="#sun-fill"></use></svg>
	<svg class="theme-toggle__icon theme-toggle__icon--moon" width="1.25em" height="1.25em" aria-hidden="true" fill="currentColor"><use href="#moon-stars-fill"></use></svg>
</button>
