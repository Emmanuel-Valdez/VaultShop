@using VaultShop.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using VaultShop.Web.Services.Branding

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IAntiforgery Antiforgery
@inject IOptions<BrandingOptions> BrandingOptionsAccessor
@inject IOptions<ThemeOptions> ThemeOptionsAccessor

@{
	var culture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
	var branding = BrandingOptionsAccessor.Value;
	var theme = ThemeOptionsAccessor.Value;
	var hasTikTok = !string.IsNullOrWhiteSpace(SD.TikTokLink);
	var hasFacebook = !string.IsNullOrWhiteSpace(SD.FacebookLink);
	var hasInstagram = !string.IsNullOrWhiteSpace(SD.InstagramLink);
	var hasWhatsApp = !string.IsNullOrWhiteSpace(SD.WhatsAppLink);
	var hasDevLink = !string.IsNullOrWhiteSpace(SD.DevLink);
	var routeArea = Context.Request.RouteValues["area"]?.ToString();
	var routeController = Context.Request.RouteValues["controller"]?.ToString();
	var routeAction = Context.Request.RouteValues["action"]?.ToString();
	var isStorefront = string.Equals(routeArea, "Customer", StringComparison.OrdinalIgnoreCase);
	var isHome = isStorefront && string.Equals(routeController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(routeAction, "Index", StringComparison.OrdinalIgnoreCase);
	var isSearch = isStorefront && string.Equals(routeController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(routeAction, "Search", StringComparison.OrdinalIgnoreCase);
	var isCart = isStorefront && string.Equals(routeController, "Cart", StringComparison.OrdinalIgnoreCase);
	var accountPage = SignInManager.IsSignedIn(User) ? "/Account/Manage/Index" : "/Account/Login";
}

<!DOCTYPE html>
<html lang="@culture">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	@{
		string? GetViewDataText(string key)
		{
			var value = ViewData[key];
			return value switch
			{
				LocalizedHtmlString h => h.Value,
				Microsoft.Extensions.Localization.LocalizedString s => s.Value,
				null => null,
				_ => value.ToString()
			};
		}

		// product-slugs 3.1: a page can publish its canonical URL (slug form) via ViewData;
		// default stays the visited path so every other page keeps today's behaviour.
		var canonicalPath = GetViewDataText("CanonicalUrl") ?? Context.Request.Path.Value;
		var currentUrl = $"{SD.SiteUrl}{canonicalPath}";
		// seo-canonical-hreflang 2.1: alternates come off the same canonical path with the culture
		// segment swapped, so they can neither repeat it nor collapse onto one URL.
		var esAlternate = $"{SD.SiteUrl}{CultureHelper.SwapCultureSegment(canonicalPath, "es-AR")}";
		var enAlternate = $"{SD.SiteUrl}{CultureHelper.SwapCultureSegment(canonicalPath, "en-US")}";
		var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
		var pageTitle = GetViewDataText("Title");
		var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? branding.PublicName : $"{pageTitle} - {branding.PublicName}";
		var description = GetViewDataText("Description");
		var keywords = GetViewDataText("Keywords");
		var robots = GetViewDataText("Robots");
		var ogImage = GetViewDataText("OgImage") ?? $"{SD.SiteUrl}{branding.SocialPreviewImagePath}";
	}
	<title>@fullTitle</title>
	<meta name="description" content="@description" />
	<meta name="keywords" content="@keywords" />
	<meta name="robots" content="@robots" />
	<meta name="request-verification-token" content="@antiforgeryToken" />
	<link rel="canonical" href="@currentUrl" />
	<link rel="alternate" hreflang="es-AR" href="@esAlternate" />
	<link rel="alternate" hreflang="en-US" href="@enAlternate" />
	<link rel="alternate" hreflang="x-default" href="@esAlternate" />

	<meta property="og:title" content="@fullTitle" />
	<meta property="og:description" content="@description" />
	<meta property="og:image" content="@ogImage" />
	<meta property="og:url" content="@currentUrl" />
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="@branding.PublicName" />
	<meta property="og:locale" content="@(culture == "es-AR" ? "es_AR" : "en_US")" />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:site" content="@branding.TwitterSite" />
	<meta name="twitter:title" content="@fullTitle" />
	<meta name="twitter:description" content="@description" />
	<meta name="twitter:image" content="@ogImage" />

	<link rel="icon" type="image/svg+xml" href="@branding.MarkPath" />
	<link rel="apple-touch-icon" href="@branding.AppleTouchIconPath" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;display=swap" rel="stylesheet" />
	<link rel="manifest" href="~/site.webmanifest" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
	<link rel="stylesheet" href="~/lib/quill/quill.snow.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href=" //cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
	<link rel="stylesheet" href="~/VaultShop.Web.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href=" https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css" />
	<link rel="stylesheet" href=" https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap5.css" />
	<link rel="stylesheet" href=" https://cdn.datatables.net/buttons/3.1.2/css/buttons.dataTables.css" />
	<link rel="stylesheet" href=" https://cdn.datatables.net/responsive/3.0.3/css/responsive.dataTables.css" />
	<link rel="stylesheet" href=" https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css" />
	<link rel="stylesheet" href=" https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.css" />

	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<style>
		:root {
			--theme-primary: @theme.PrimaryCss;
			--theme-primary-rgb: @theme.PrimaryRgb;
			--theme-primary-dark: @theme.PrimaryDarkCss;
			--theme-primary-dark-rgb: @theme.PrimaryDarkRgb;
			--theme-accent: @theme.AccentCss;
			--theme-accent-rgb: @theme.AccentRgb;
			--theme-surface: @theme.SurfaceCss;
			--theme-surface-rgb: @theme.SurfaceRgb;
			--theme-surface-dark: @theme.SurfaceDarkCss;
		}
	</style>


</head>
<body class="@(isStorefront ? "storefront-body" : null)">
	<header class="sticky-top">
		<nav class="navbar navbar-expand-lg d-flex bg-primary" aria-label="Main navigation">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">
					<img src="@branding.LogoDarkPath" alt="@branding.PublicName" style="width:150px; max-width:48vw;" />
				</a>
				@if (!isStorefront)
				{
					<button class="navbar-toggler collapsed border-0" type="button"
							aria-label="@Localizer["Menu"]"
							data-bs-toggle="offcanvas"
							data-bs-target="#sideNavbarTop"
							aria-controls="sideNavbarTop"
							aria-expanded="false">
						<i class="fs-2 bi bi-list text-secondary"></i>
					</button>
				}
				<section class="offcanvas offcanvas-end bg-primary" id="sideNavbarTop" tabindex="-1" aria-labelledby="sideNavbarTopTitle">
					<div class="offcanvas-header ">
						<h5 id="sideNavbarTopTitle" class="offcanvas-title text-secondary text-center">@Localizer["Slogan"]</h5>
						<button class="btn-close btn-close-white" type="button" aria-label="@Localizer["Close"]" data-bs-dismiss="offcanvas"></button>
					</div>
					<div class="offcanvas-body d-flex flex-column justify-content-between px-3 ">
						<ul class="navbar-nav me-auto fs-5  flex-grow-1 ">
							@if (!isStorefront)
							{
								<li class="nav-item p-sm-3 py-md-1 ">
									<a class="nav-link text-secondary" asp-area="Customer" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a>
								</li>
							}

							@if (isStorefront)
							{
								@await Component.InvokeAsync("StorefrontMenu", new
								{
									categoryHeading = Localizer["ShopByCategory"].Value,
									collectionHeading = Localizer["ShopByCollection"].Value
								})
							}

							@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
							{
								<li class="nav-item dropdown py-md-1 p-sm-3">
									<a class="nav-link dropdown-toggle text-secondary" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
										@Localizer["ContentManagment"]
									</a>
									<ul class="dropdown-menu">
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="Category" asp-action="Index">@Localizer["Category"]</a>
										</li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="Product" asp-action="Index">@Localizer["Product"]</a>
										</li>
										<li class="nav-item ">
										<a class="dropdown-item " asp-area="Admin" asp-controller="Keyword" asp-action="Index">@Localizer["Keywords"]</a>
									</li>
									<li class="nav-item ">
										<a class="dropdown-item " asp-area="Admin" asp-controller="Banner" asp-action="Index">@Localizer["Banners"]</a>
									</li>
									<li class="nav-item ">
										<a class="dropdown-item " asp-area="Admin" asp-controller="Company" asp-action="Index">@Localizer["Company"]</a>
									</li>
									<li class="nav-item ">
										<a class="dropdown-item " asp-area="Admin" asp-controller="Coupon" asp-action="Index">@Localizer["Coupons"]</a>
									</li>
									<li class="nav-item ">
										<a class="dropdown-item " asp-area="Admin" asp-controller="Promotion" asp-action="Index">@Localizer["Promotions"]</a>
									</li>
										<li><hr class="dropdown-divider" /></li>
										<li class="nav-item">
											<a class="dropdown-item " asp-area="Identity" asp-page="/Account/Register">@Localizer["CreateUser"]</a>
										</li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="User" asp-action="Index">@Localizer["ManageUsers"]</a>
										</li>
									</ul>
								</li>
								<li class="nav-item dropdown py-md-1 p-sm-3">
									<a class="nav-link dropdown-toggle text-secondary" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
										@Localizer["CostCalculator"]
									</a>
									<ul class="dropdown-menu">
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="Packaging" asp-action="Index">@Localizer["Packaging"]</a>
										</li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="PackagingByCategory" asp-action="Index">@Localizer["PackagingByCategory"]</a>
										</li>
										<li><hr class="dropdown-divider" /></li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="Fabric" asp-action="Index">@Localizer["Fabric"]</a>
										</li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="FabricByProduct" asp-action="Index">@Localizer["FabricByProduct"]</a>
										</li>
										<li><hr class="dropdown-divider " /></li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="GarmentHardware" asp-action="Index">@Localizer["GarmentHardware"]</a>
										</li>
										<li class="nav-item">
											<a class="dropdown-item " asp-area="Admin" asp-controller="GarmentHardwareByProduct" asp-action="Index">@Localizer["GarmentHardwareByProduct"]</a>
										</li>
										<li><hr class="dropdown-divider" /></li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="FixedCost" asp-action="Index">@Localizer["FixedCost"]</a>
										</li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="PercentageCost" asp-action="Index">@Localizer["RetailPercentageCost"]</a>
										</li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="PercentageCostWholesale" asp-action="Index">@Localizer["WholesalePercentageCost"]</a>
										</li>
										<li><hr class="dropdown-divider" /></li>
										<li class="nav-item">
											<a class="dropdown-item " asp-area="Admin" asp-controller="ProductPrice" asp-action="CostByProduct">@Localizer["CostByProduct"]</a>
										</li>
										<li class="nav-item ">
											<a class="dropdown-item " asp-area="Admin" asp-controller="ProductPrice" asp-action="Index">@Localizer["FinalPrice"]</a>
										</li>
									</ul>
								</li>
							}
							@if (SignInManager.IsSignedIn(User))
							{
								<li class="nav-item p-sm-3 py-md-1">
									<a class="nav-link text-secondary" asp-area="Admin" asp-controller="Order" asp-action="Index">@Localizer["ManageOrder"]</a>
								</li>
							}
							@if (SignInManager.IsSignedIn(User))
							{
								<li class="nav-item p-sm-3 py-md-1">
									<a class="nav-link text-secondary" asp-area="Customer" asp-controller="Favorite" asp-action="Index">
										<i class="bi bi-heart-fill"></i> @Localizer["Favs"]
									</a>
								</li>
							}
						</ul>
						<form asp-area="Customer" asp-controller="Home" asp-action="Search" class="nav-item p-3 py-3 d-flex d-lg-none nav-justified" role="search" method="get">
							<input id="storefrontMenuSearch" class="form-control me-2" name="searchString" type="search" placeholder="@Localizer["Search"]" aria-label="@Localizer["Search"]">
							<button class="btn btn-secondary" type="submit" aria-label="@Localizer["Search"]"><i class="bi bi-search-heart fs-4" aria-hidden="true"></i></button>
						</form>
						<div class="d-lg-none align-self-center py-3">
							@if (hasTikTok) { <a href="@SD.TikTokLink" target="_blank" rel="noopener" aria-label="TikTok"><i class="bi bi-tiktok px-2 text-secondary fs-2" aria-hidden="true"></i></a> }
							@if (hasFacebook) { <a href="@SD.FacebookLink" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook px-2 text-secondary fs-2" aria-hidden="true"></i></a> }
							@if (hasInstagram) { <a href="@SD.InstagramLink" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram px-2 text-secondary fs-2" aria-hidden="true"></i></a> }
							@if (hasWhatsApp) { <a href="@SD.WhatsAppLink" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp px-2 text-secondary fs-2" aria-hidden="true"></i></a> }
						</div>
					</div>
				</section>
				@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
				{
					var isWholesalePreview = VaultShop.Web.Services.Pricing.PricingHelper.IsWholesalePreview(Context);
					<div class="dropdown ms-2 me-1">
						<button class="btn nav-link text-secondary px-2 d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Localizer["Settings"]" title="@Localizer["Settings"]">
							<i class="bi bi-gear fs-5" aria-hidden="true"></i>
						</button>
						<div class="dropdown-menu dropdown-menu-end shadow p-2" style="min-width:14rem;">
							@if (User.IsInRole(SD.Role_Admin))
							{
								<a class="dropdown-item" asp-area="Admin" asp-controller="System" asp-action="Version"><i class="bi bi-info-circle me-2" aria-hidden="true"></i>@Localizer["Version"]</a>
								<hr class="dropdown-divider" />
							}
							<div class="px-1">
								<div class="small text-muted mb-1">@Localizer["PreviewMode"]</div>
								<form asp-area="Customer" asp-controller="Home" asp-action="SetPreviewMode" method="post" class="m-0">
									<input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString.ToUriComponent())" />
									<div class="btn-group btn-group-sm w-100" role="group" aria-label="@Localizer["PreviewMode"]">
										<button type="submit" name="mode" value="retail" class="btn @(isWholesalePreview ? "btn-outline-primary" : "btn-primary")" aria-pressed="@(!isWholesalePreview ? "true" : "false")">@Localizer["Retail"]</button>
										<button type="submit" name="mode" value="wholesale" class="btn @(isWholesalePreview ? "btn-primary" : "btn-outline-primary")" aria-pressed="@(isWholesalePreview ? "true" : "false")">@Localizer["Wholesale"]</button>
									</div>
								</form>
							</div>
						</div>
					</div>
				}
				<div class="nav-item @(isStorefront ? "d-none d-lg-block" : null)">
					<a class="nav-link text-secondary position-relative p-2 lh-1 d-inline-flex align-items-center" asp-area="Customer" asp-controller="Cart" asp-action="Index" aria-label="@Localizer["Cart"]">
						@await Component.InvokeAsync("ShoppingCart")
					</a>
				</div>
			</div>
		</nav>
	</header>
	<nav class="navbar navbar-expand-lg bg-secondary @(isStorefront ? "d-none d-lg-flex" : null)">
		<div class="container-fluid">
			<form asp-area="Customer" asp-controller="Home" asp-action="Search" class="d-flex nav-justified " role="search" method="get">
				<input class="form-control me-1" name="searchString" type="search" placeholder="@Localizer["Search"]" aria-label="Search">
				<button class="btn btn-outline-primary" type="submit"><i class="bi bi-search-heart fs-4"></i> </button>
			</form>
			<div class=" dropdown ms-1">
				<a class="nav-link text-primary mx-1" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
					<span class="d-none d-lg-inline fs-5"> @Localizer["MyAccount"]</span><i class="bi bi-person fs-4"></i>
				</a>
				<partial name="_loginPartial" />
			</div>

		</div>
	</nav>

	<div class="container">
		@if (VaultShop.Web.Services.Pricing.PricingHelper.IsWholesalePreview(Context))
		{
			<div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 mb-0" role="status" aria-label="Wholesale preview active">
				<span>@Localizer["PreviewWholesaleLabel"]</span>
				<form asp-area="Customer" asp-controller="Home" asp-action="SetPreviewMode" method="post" class="m-0">
					<input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString.ToUriComponent())" />
					<button type="submit" name="mode" value="retail" class="btn btn-sm btn-outline-dark">@Localizer["ExitPreviewButton"]</button>
				</form>
			</div>
		}
		<main role="main" class="pb-3">
			<partial name="_Notification" />
			@RenderBody()
		</main>
	</div>
	<div class="container">
		<footer class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top  bg-gradient rounded">
			<div class="col-md-4 d-flex align-items-center">
				<a class="navbar-brand px-4 " asp-area="" asp-controller="Home" asp-action="Index">
					<img class="footer-logo footer-logo--light" src="@branding.LogoPath" alt="@branding.PublicName" style="width:170px; max-width:52vw;" />
					<img class="footer-logo footer-logo--dark" src="@branding.LogoDarkPath" alt="@branding.PublicName" style="width:170px; max-width:52vw;" />
				</a>

				@if (hasDevLink)
				{
					<div class="container">
						<a class="footer-signature" href="@SD.DevLink"
						   target="_blank"
						   rel="noopener"
						   aria-label="Developer: EValdez">
							<img class="footer-signature__mark" src="~/images/dev-signature.svg" asp-append-version="true" alt="" width="44" height="19" />
						</a>
					</div>
				}
			</div>
			<div class="language-selector"> 
				<form method="post" asp-area="Customer" asp-controller="Home" asp-action="SetLanguage">
					<input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString.ToUriComponent())" />
					@{
						var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
					}
					<div class="btn-group" role="group" aria-label="Language selector">
						<button type="submit" name="culture" value="es-AR" class="btn @(currentCulture == "es-AR" ? "btn-language-active" : "btn-language")" title="Español" aria-label="Cambiar a español" aria-pressed="@(currentCulture == "es-AR")">
							<img src="~/images/flags/argentina.svg" asp-append-version="true" alt="" width="30" height="20" />
							<span class="visually-hidden">Español</span>
						</button>
						<button type="submit" name="culture" value="en-US" class="btn @(currentCulture == "en-US" ? "btn-language-active" : "btn-language")" title="English" aria-label="Switch to English" aria-pressed="@(currentCulture == "en-US")">
							<img src="~/images/flags/uk.svg" asp-append-version="true" alt="" width="30" height="20" />
							<span class="visually-hidden">English</span>
						</button>
					</div>
				</form> 
			</div>
			<div class="align-self-end py-3 ">
				@if (hasTikTok) { <a href="@SD.TikTokLink" target="_blank" rel="noopener" aria-label="TikTok"><i class="bi bi-tiktok px-2 icon-link fs-2" aria-hidden="true"></i></a> }
				@if (hasFacebook) { <a href="@SD.FacebookLink" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook px-2 icon-link fs-2" aria-hidden="true"></i></a> }
				@if (hasInstagram) { <a href="@SD.InstagramLink" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram px-2 icon-link fs-2" aria-hidden="true"></i></a> }
				@if (hasWhatsApp) { <a href="@SD.WhatsAppLink" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp px-2 icon-link fs-2" aria-hidden="true"></i></a> }
			</div>
			<nav class="footer-links w-100" aria-label="@Localizer["Information"]">
				<a asp-area="Customer" asp-controller="Home" asp-action="FAQs">@Localizer["FAQs"]</a>
				<a asp-area="Customer" asp-controller="Home" asp-action="AboutUs">@Localizer["AboutUs"]</a>
				<a asp-area="Customer" asp-controller="Home" asp-action="TakeCare">@Localizer["TakeCare"]</a>
				@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee) || User.IsInRole(SD.Role_Company))
				{
					<a asp-area="Customer" asp-controller="Home" asp-action="Wholesale">@Localizer["Wholesale"]</a>
				}
				<a asp-area="Customer" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
				<a asp-area="Customer" asp-controller="Home" asp-action="Terms">@Localizer["Terms"]</a>
				@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
				{
					<a asp-area="Customer" asp-controller="Home" asp-action="Help">@Localizer["Help"]</a>
				}
			</nav>
		</footer>
	</div>

	@if (isStorefront)
	{
		<nav class="storefront-mobile-nav d-lg-none" aria-label="@Localizer["StorefrontNavigation"]">
			<ul class="storefront-mobile-nav__list">
				<li>
					<a class="storefront-mobile-nav__link @(isHome ? "is-active" : null)" asp-area="Customer" asp-controller="Home" asp-action="Index" aria-current="@(isHome ? "page" : null)">
						<i class="bi bi-house-door" aria-hidden="true"></i>
						<span>@Localizer["Home"]</span>
					</a>
				</li>
				<li>
					@* ponytail: Stage 2 opens the menu search field; Stage 3 replaces this trigger with the full-screen overlay. *@
					<button type="button" class="storefront-mobile-nav__link @(isSearch ? "is-active" : null)" data-bs-toggle="offcanvas" data-bs-target="#sideNavbarTop" data-storefront-search-open aria-controls="sideNavbarTop" aria-expanded="false" aria-current="@(isSearch ? "page" : null)">
						<i class="bi bi-search" aria-hidden="true"></i>
						<span>@Localizer["Search"]</span>
					</button>
				</li>
				<li>
					<a class="storefront-mobile-nav__link @(isCart ? "is-active" : null)" asp-area="Customer" asp-controller="Cart" asp-action="Index" aria-current="@(isCart ? "page" : null)">
						<span class="storefront-mobile-nav__icon">
							@await Component.InvokeAsync("ShoppingCart")
						</span>
						<span>@Localizer["Cart"]</span>
					</a>
				</li>
				<li>
					<a class="storefront-mobile-nav__link" asp-area="Identity" asp-page="@accountPage">
						<i class="bi bi-person" aria-hidden="true"></i>
						<span>@Localizer["MyAccount"]</span>
					</a>
				</li>
				<li>
					<button type="button" class="storefront-mobile-nav__link" data-bs-toggle="offcanvas" data-bs-target="#sideNavbarTop" aria-controls="sideNavbarTop" aria-expanded="false">
						<i class="bi bi-list" aria-hidden="true"></i>
						<span>@Localizer["Menu"]</span>
					</button>
				</li>
			</ul>
		</nav>
	}

	<partial name="_ThemeToggle" />
	<script type="text/javascript">
		var currentCulture = `@System.Threading.Thread.CurrentThread.CurrentUICulture.Name`
	</script>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script>
		$.ajaxSetup({
			beforeSend: function (xhr, settings) {
				if (settings.type && settings.type.toUpperCase() !== 'GET') {
					xhr.setRequestHeader('RequestVerificationToken', $('meta[name="request-verification-token"]').attr('content'));
				}
			}
		});
	</script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	
	<script src="~/js/site.js" asp-append-version="true"></script>
	
	<script src="~/js/utils.js" asp-append-version="true"></script>
	<script src="~/js/passwordToggle.js" asp-append-version="true"></script>
