@model VaultShop.Models.ViewModels.CollectionHeroVM
@* ponytail: single-ratio srcset (density only); legacy partial sets fall back to the widest single img *@
<section class="collection-hero--breakout u-breakout" data-collection-hero aria-label="@Model.Title">
	@if (!string.IsNullOrWhiteSpace(Model.MediumImageUrl) && !string.IsNullOrWhiteSpace(Model.SmallImageUrl))
	{
		<img src="@Model.ImageUrl" srcset="@Model.SmallImageUrl 768w, @Model.MediumImageUrl 1280w, @Model.ImageUrl 1905w" sizes="100vw" alt="@Model.Title" class="collection-hero__image" fetchpriority="high" loading="eager" decoding="async" />
	}
	else
	{
		<img src="@Model.ImageUrl" alt="@Model.Title" class="collection-hero__image" fetchpriority="high" loading="eager" decoding="async" />
	}
	<div class="collection-hero__scrim" aria-hidden="true"></div>
	<div class="collection-hero__content">
		<h1 class="collection-hero__title">@Model.Title</h1>
		@if (Model.Count > 0)
		{
			<span class="collection-hero__count">· @Model.Count productos</span>
		}
	</div>
</section>
